{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "off",
    "style": "off",
    "pedantic": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    // Disabled: the `__` prefix on test-only reset hooks (`__resetExtractorCache`,
    // `__resetConverterCache`) is a deliberate self-policing convention marking
    // them as not part of the public API; see the JSDoc on each. Maintaining an
    // allow-list here would silently fail-lint future reset hooks.
    "eslint/no-underscore-dangle": "off",
    // Relative imports must carry a `.js` extension, never `.ts`. There is no build
    // step, so the written extension is the resolution contract — jiti, vitest, tsgo
    // and tsx all map `./x.js` onto `x.ts`, and `.js` is what a compiled consumer
    // would need. See #212.
    // Use the `"ignorePackages"` mode string, not `"always"` with
    // `{ "ignorePackages": true }`. Oxlint 1.76 ignores the option in object form
    // and then reports every bare specifier, `typebox` and `node:*` included.
    "import/extensions": [
      "error",
      "ignorePackages",
      { "checkTypeImports": true, "pattern": { "ts": "never" } }
    ]
  },
  "overrides": [
    {
      "files": ["test/**"],
      // Must mirror the top-level `plugins` list + `vitest`. Oxlint overrides
      // replace (don't merge) the array; if you add a plugin above, add it here too.
      "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise", "vitest"],
      "rules": {
        // Disabled for tests only (new in oxlint 1.76). Test helpers are
        // deliberately declared inside the `describe` they serve — `stubDns`,
        // `mockFetchSequence`, `overflowChild` and friends read as part of that
        // block's setup. Hoisting them to module scope to satisfy the rule
        // would scatter setup away from the tests that use it and invite reuse
        // across blocks that should stay independent. The recreate-per-call
        // cost the rule guards against is irrelevant in a test file.
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
