    {
      "name": "tool:websearch",
      "keywords": [],
      "schema": {
        "type": "object",
        "required": ["query", "limit", "region", "safesearch", "time"],
        "properties": {
          "query": {
            "type": "string",
            "description": "The search query (free-form text)."
          },
          "limit": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Max number of results (default 8, hard cap 25). Pass null to use the default."
          },
          "region": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z]{2}-[a-z]{2}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "DuckDuckGo region code, e.g. 'pl-pl', 'us-en', 'de-de'. Pass null for ddgr's built-in default (us-en). Well-formed but unknown codes fall back to that default."
          },
          "safesearch": {
            "anyOf": [
              {
                "type": "string",
                "const": "off"
              },
              {
                "type": "string",
                "const": "moderate"
              },
              {
                "type": "string",
                "const": "strict"
              },
              {
                "type": "null"
              }
            ],
            "description": "Safe search level. 'off' disables it (passes --unsafe to ddgr). 'moderate' (default, also used when null) and 'strict' both use ddgr's default safe-search behavior; ddgr does not distinguish them."
          },
          "time": {
            "anyOf": [
              {
                "type": "string",
                "const": "d"
              },
              {
                "type": "string",
                "const": "w"
              },
              {
                "type": "string",
                "const": "m"
              },
              {
                "type": "string",
                "const": "y"
              },
              {
                "type": "null"
              }
            ],
            "description": "Time filter: 'd' (past day), 'w' (past week), 'm' (past month), 'y' (past year). Pass null for no filter (all time). Use when the query is time-sensitive ('latest', 'recent', 'this week') — DuckDuckGo's default ranking otherwise surfaces years-old SEO content above recent results."
          }
        },
        "additionalProperties": false
      },
      "accepted": true,
      "status": 200,
      "error": null
    },
